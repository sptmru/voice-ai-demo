# Shared by Compose, the API, migrations, seed and integration tests.
POSTGRES_USER=relay
POSTGRES_PASSWORD='relay_local'
POSTGRES_DB=relay
DB_HOST=db
DB_PORT=5432
# Optional external database override for host processes (percent-encode credentials):
# DATABASE_URL=postgresql://user:encoded-password@host:5432/database
# Host port for the whole Compose application (web, /api, SSE and voice WebSocket).
# Container ports stay fixed: web 3100, API 3101.
PORT=3100
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3100
COOKIE_SECURE=false
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Local multilingual embeddings + multilingual cross-encoder (download once, CPU inference).
EMBEDDING_CACHE=.cache/models
RAG_EMBEDDING_MODEL=Xenova/multilingual-e5-small
RAG_RERANKER=on
RAG_INFERENCE_THREADS=2
# Changing embedding models requires rag:reindex; see docs/rag.md.
# Relevance thresholds are evaluation parameters, not confidence percentages.
# RAG_MIN_SEMANTIC_SCORE=0.70
# RAG_MIN_RERANK_SCORE=0.12
# Voice uses the page's hostname/port by default. Override only for a separate proxy origin.
# VOICE_PUBLIC_URL=wss://relay.example.com

# Server-only Google Calendar integration. Leave all four empty for explicit demo mode.
# Setup and scopes: docs/calendar.md. Never put these in NEXT_PUBLIC_* variables.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIME_ZONE=Asia/Yerevan

# Conversational repair text and photo reading. auto uses OpenAI, then Gemini.
# Rehearsal still uses configured AI providers; only business writes stay local.
TEXT_PROVIDER=auto
VISION_PROVIDER=auto
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Set TEXT_PROVIDER=deterministic and VISION_PROVIDER=off for fully local fallback.
